{
  "name": "safekey-vault",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c green,cyan \"node --watch server.mjs\" \"vite --host 0.0.0.0\"",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview --host 0.0.0.0",
    "server": "node server.mjs",
    "start": "node server.mjs --production",
    "check": "tsc -b && node --check server.mjs",
    "test:cloud": "node scripts/cloud-smoke.mjs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "lucide-react": "^0.468.0",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "^10.0.5",
    "typescript": "latest",
    "vite": "latest"
  }
}
